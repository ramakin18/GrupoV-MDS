# ============================================================
# Backend - Variables de Entorno
# Copia este archivo a .env y completá los valores
# ============================================================

# Database
DB_URL=jdbc:postgresql://localhost:5432/tu_db?sslmode=require
DB_USER=tu_usuario
DB_PASS=tu_contraseña

# Server
PORT=8081

# JPA
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true

# Cloudinary (opcional en dev)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Activar perfil (dev por defecto, usar prod en producción)
SPRING_PROFILES_ACTIVE=dev
